@model PersonalFinanceManager.Models.LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<section class="auth-page"><div class="auth-card"><a class="brand auth-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">S</span><span>spendwise</span></a><h1>Welcome back</h1><p>Sign in to manage your personal finances.</p><form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span></div><div class="form-group"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger small"></span></div><button class="primary-button auth-submit" type="submit">Sign in</button></form><p class="auth-switch">New to SpendWise? <a asp-action="Register">Create an account</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
