@model PersonalFinanceManager.Models.RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<section class="auth-page"><div class="auth-card"><a class="brand auth-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">S</span><span>spendwise</span></a><h1>Create your account</h1><p>Your financial data stays private to your account.</p><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span></div><div class="form-group"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger small"></span></div><div class="form-group"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div><button class="primary-button auth-submit" type="submit">Create account</button></form><p class="auth-switch">Already have an account? <a asp-action="Login">Sign in</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
