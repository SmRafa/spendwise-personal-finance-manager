@model PersonalFinanceManager.Models.Account
@{ ViewData["Title"] = "Add account"; }
<section class="dashboard-header"><div><p class="eyebrow">ACCOUNT SETUP</p><h1>Add a new account</h1><p class="subtle">Add the wallet, cash or bank account you use for spending.</p></div><a class="back-link" asp-action="Index">← Back to accounts</a></section>
<section class="form-panel"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="form-group"><label asp-for="Name"></label><input asp-for="Name" class="form-control" placeholder="e.g. HBL Bank, Wallet, Cash" /><span asp-validation-for="Name" class="text-danger small"></span></div><div class="form-group"><label asp-for="Type"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<PersonalFinanceManager.Models.AccountType>()" class="form-select"></select></div><div class="form-group"><label asp-for="OpeningBalance"></label><div class="amount-input"><span>Rs.</span><input asp-for="OpeningBalance" class="form-control" type="number" min="0" step="0.01" /></div><span asp-validation-for="OpeningBalance" class="text-danger small"></span></div><div class="form-actions"><a asp-action="Index" class="cancel-button">Cancel</a><button type="submit" class="primary-button">Save account</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
