@model PersonalFinanceManager.Controllers.AdminDashboardViewModel
@{ViewData["Title"]="Admin";}
<section class="dashboard-header"><div><p class="eyebrow">ADMINISTRATION</p><h1>Admin dashboard</h1><p class="subtle">Overview of SpendWise users and platform data.</p></div></section><section class="stats-grid"><article class="stat-card"><div class="stat-head"><span>Users</span></div><h2>@Model.Users.Count</h2></article><article class="stat-card"><div class="stat-head"><span>Accounts</span></div><h2>@Model.Accounts</h2></article><article class="stat-card"><div class="stat-head"><span>Transactions</span></div><h2>@Model.Transactions</h2></article><article class="stat-card"><div class="stat-head"><span>Goals</span></div><h2>@Model.Goals</h2></article></section><section class="panel transactions-panel"><div class="panel-heading"><div><h3>Registered users</h3><p>Accounts that can access SpendWise</p></div></div>@foreach(var user in Model.Users){<div class="transaction-row"><span class="transaction-icon salary">U</span><div><strong>@user.Email</strong><small>Created @user.SecurityStamp?.Substring(0,8)</small></div><span class="account-pill">User</span><span></span><span></span></div>}</section>
