@model PersonalFinanceManager.Models.Budget
@{ ViewData["Title"] = "Edit budget"; }
<section class="dashboard-header"><div><p class="eyebrow">MONTHLY PLAN</p><h1>Edit budget</h1><p class="subtle">Update the monthly spending limit.</p></div><a class="back-link" asp-action="Index">← Back to budgets</a></section>
<section class="form-panel"><form asp-action="Edit" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="form-group"><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" disabled></select><input asp-for="CategoryId" type="hidden" /></div><div class="form-group"><label asp-for="Amount"></label><div class="amount-input"><span>Rs.</span><input asp-for="Amount" class="form-control" type="number" min="1" step="0.01" /></div><span asp-validation-for="Amount" class="text-danger small"></span></div><div class="form-actions"><a asp-action="Index" class="cancel-button">Cancel</a><button type="submit" class="primary-button">Save changes</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
