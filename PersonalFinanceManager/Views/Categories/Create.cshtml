@model PersonalFinanceManager.Models.Category
@{ ViewData["Title"] = "Add category"; }
<section class="dashboard-header"><div><p class="eyebrow">CATEGORY SETUP</p><h1>Add a category</h1><p class="subtle">Create a label for your income or expenses.</p></div><a class="back-link" asp-action="Index">← Back to categories</a></section>
<section class="form-panel"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="form-group"><label asp-for="Name"></label><input asp-for="Name" class="form-control" placeholder="e.g. Groceries, Rent, Bonus" /><span asp-validation-for="Name" class="text-danger small"></span></div><div class="form-group"><label asp-for="Type"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<PersonalFinanceManager.Models.CategoryType>()" class="form-select"></select></div><div class="form-group"><label asp-for="Color"></label><div class="color-field"><input asp-for="Color" type="color" /><input asp-for="Color" class="form-control" /><span asp-validation-for="Color" class="text-danger small"></span></div></div><div class="form-actions"><a asp-action="Index" class="cancel-button">Cancel</a><button type="submit" class="primary-button">Save category</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
