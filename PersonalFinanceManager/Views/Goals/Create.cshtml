@model PersonalFinanceManager.Models.FinancialGoal
@{ ViewData["Title"]="Create goal"; }
<section class="dashboard-header"><div><p class="eyebrow">START SAVING</p><h1>Create a goal</h1></div><a class="back-link" asp-action="Index">← Back</a></section><section class="form-panel"><form asp-action="Create" method="post"><div class="form-group"><label asp-for="Name"></label><input asp-for="Name" class="form-control" placeholder="e.g. Emergency fund"/><span asp-validation-for="Name" class="text-danger small"></span></div><div class="form-group"><label asp-for="TargetAmount"></label><input asp-for="TargetAmount" class="form-control" type="number" min="1"/><span asp-validation-for="TargetAmount" class="text-danger small"></span></div><div class="form-group"><label asp-for="CurrentAmount"></label><input asp-for="CurrentAmount" class="form-control" type="number" min="0"/></div><div class="form-group"><label asp-for="TargetDate"></label><input asp-for="TargetDate" class="form-control"/></div><div class="form-actions"><a asp-action="Index" class="cancel-button">Cancel</a><button class="primary-button">Create goal</button></div></form></section>
