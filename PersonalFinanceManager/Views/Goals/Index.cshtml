@model IEnumerable<PersonalFinanceManager.Models.FinancialGoal>
@{ ViewData["Title"]="Goals"; }
<section class="dashboard-header"><div><p class="eyebrow">BUILD YOUR FUTURE</p><h1>Financial goals</h1><p class="subtle">Track your saving plans in one focused place.</p></div><a class="primary-button text-decoration-none" asp-action="Create">＋ Create goal</a></section>
<section class="goal-grid">@foreach(var goal in Model){<article class="goal-card"><span class="goal-badge">@(goal.Percentage==100?"Achieved":"In progress")</span><h3>@goal.Name</h3><p>@(goal.TargetDate.HasValue?$"Target: {goal.TargetDate.Value:dd MMM yyyy}":"No target date")</p><div class="goal-amount"><strong>Rs. @goal.CurrentAmount.ToString("N0")</strong><span>of Rs. @goal.TargetAmount.ToString("N0")</span></div><div class="progress"><div class="progress-bar" style="width:@goal.Percentage%"></div></div><div class="goal-progress"><span>@goal.Percentage% complete</span><b>Rs. @((goal.TargetAmount-goal.CurrentAmount).ToString("N0")) left</b></div>@if(goal.Percentage<100){<form class="goal-contribution" asp-action="Contribute" asp-route-id="@goal.Id" method="post"><input name="amount" type="number" min="1" placeholder="Add savings" required/><button type="submit">Add</button></form>}</article>}@if(!Model.Any()){<div class="empty-state"><div>◎</div><h3>No financial goals yet</h3><p>Create a goal for your next big plan.</p><a class="primary-button text-decoration-none" asp-action="Create">Create goal</a></div>}</section>
