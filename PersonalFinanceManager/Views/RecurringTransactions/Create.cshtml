@model PersonalFinanceManager.Models.RecurringTransaction
@{ ViewData["Title"] = "Schedule monthly entry"; }
<section class="dashboard-header"><div><p class="eyebrow">AUTOMATE YOUR FINANCES</p><h1>Schedule monthly transaction</h1><p class="subtle">A transaction will be added each month on the selected due date.</p></div><a class="back-link" asp-action="Index">← Back to schedules</a></section>
<section class="form-panel"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="form-group"><label asp-for="Type"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<PersonalFinanceManager.Models.TransactionType>()" class="form-select"></select></div><div class="form-group"><label asp-for="Note"></label><input asp-for="Note" class="form-control" placeholder="e.g. Monthly salary or House rent" /><span asp-validation-for="Note" class="text-danger small"></span></div><div class="form-group"><label asp-for="AccountId"></label><select asp-for="AccountId" asp-items="ViewBag.Accounts" class="form-select"><option value="">Select account</option></select><span asp-validation-for="AccountId" class="text-danger small"></span></div><div class="form-group"><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">Select category</option></select><span asp-validation-for="CategoryId" class="text-danger small"></span></div><div class="form-group"><label asp-for="Amount"></label><div class="amount-input"><span>Rs.</span><input asp-for="Amount" class="form-control" type="number" min="1" step="0.01" /></div><span asp-validation-for="Amount" class="text-danger small"></span></div><div class="form-group"><label asp-for="NextDueDate"></label><input asp-for="NextDueDate" class="form-control" /></div><div class="form-actions"><a asp-action="Index" class="cancel-button">Cancel</a><button type="submit" class="primary-button">Save schedule</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
