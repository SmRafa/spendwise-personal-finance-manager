@model IEnumerable<PersonalFinanceManager.Models.RecurringTransaction>
@{ ViewData["Title"] = "Recurring transactions"; }
<section class="dashboard-header"><div><p class="eyebrow">AUTOMATE ROUTINE ENTRIES</p><h1>Recurring transactions</h1><p class="subtle">Monthly salary, rent and bills are automatically added on their due date.</p></div><a class="primary-button text-decoration-none" asp-action="Create"><span>＋</span> Schedule monthly entry</a></section>
@if (TempData["Success"] is string message) { <div class="alert alert-success border-0 shadow-sm">@message</div> }
<section class="ledger-panel"><div class="ledger-head recurring-head"><span>Description</span><span>Account</span><span>Next due</span><span>Amount</span><span></span></div>
@foreach (var item in Model) { <article class="ledger-row recurring-row"><div><i class="@(item.Type == PersonalFinanceManager.Models.TransactionType.Income ? "income-icon" : "expense-icon")">↻</i><p><strong>@item.Note</strong><small>@item.Category?.Name · Monthly · @(item.IsActive ? "Active" : "Paused")</small></p></div><span>@item.Account?.Name</span><span>@item.NextDueDate.ToString("dd MMM yyyy")</span><b class="@(item.Type == PersonalFinanceManager.Models.TransactionType.Income ? "income" : "expense")">@(item.Type == PersonalFinanceManager.Models.TransactionType.Income ? "+" : "−") Rs. @item.Amount.ToString("N0")</b><span><form class="inline-form" asp-action="Toggle" asp-route-id="@item.Id" method="post"><button class="edit-link" type="submit">@(item.IsActive ? "Pause" : "Resume")</button></form><form class="inline-form" asp-action="Delete" asp-route-id="@item.Id" method="post"><button onclick="return confirm('Delete this schedule?')" aria-label="Delete schedule">×</button></form></span></article> }
@if (!Model.Any()) { <div class="empty-state"><div>↻</div><h3>No recurring transactions</h3><p>Schedule your salary, rent or a monthly bill once and SpendWise will create it for you.</p><a class="primary-button text-decoration-none" asp-action="Create">Schedule one</a></div> }</section>
