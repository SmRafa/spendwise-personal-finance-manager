@model PersonalFinanceManager.Models.ReportViewModel
@{ ViewData["Title"] = "Reports"; }
<section class="dashboard-header"><div><p class="eyebrow">UNDERSTAND YOUR MONEY</p><h1>Financial reports</h1><p class="subtle">Review your income, spending and cash flow for any period.</p></div><div class="d-flex gap-2"><a class="edit-link" asp-action="Print" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">Print / PDF</a><a class="primary-button text-decoration-none" asp-action="ExportCsv" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">⇩ Export CSV</a></div></section>
<section class="report-filter"><form method="get"><div><label>From</label><input name="startDate" type="date" value="@Model.StartDate.ToString("yyyy-MM-dd")" /></div><div><label>To</label><input name="endDate" type="date" value="@Model.EndDate.ToString("yyyy-MM-dd")" /></div><button class="primary-button" type="submit">Apply filter</button></form></section>
<section class="stats-grid report-stats"><article class="stat-card"><div class="stat-head"><span>Total income</span><span class="stat-icon green">↓</span></div><h2>Rs. @Model.TotalIncome.ToString("N0")</h2><p class="positive">Selected period</p></article><article class="stat-card"><div class="stat-head"><span>Total expenses</span><span class="stat-icon red">↑</span></div><h2>Rs. @Model.TotalExpense.ToString("N0")</h2><p class="negative">Selected period</p></article><article class="stat-card"><div class="stat-head"><span>Net cash flow</span><span class="stat-icon">◈</span></div><h2>Rs. @Model.NetCashFlow.ToString("N0")</h2><p class="@(Model.NetCashFlow >= 0 ? "positive" : "negative")">Income minus expenses</p></article></section>
<section class="report-grid"><article class="panel"><div class="panel-heading"><div><h3>Expense by category</h3><p>Where your money went</p></div></div><div class="category-report-list">@foreach (var item in Model.CategorySpending) { <div><div class="report-category-title"><span><i style="background:@item.Color"></i>@item.CategoryName</span><b>Rs. @item.Amount.ToString("N0") <small>@item.Percentage.ToString("0")%</small></b></div><div class="progress"><div class="progress-bar" style="width:@item.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div></div></div> }@if (!Model.CategorySpending.Any()) { <div class="empty-mini">No expense data for this period.</div> }</div></article><article class="panel"><div class="panel-heading"><div><h3>Period summary</h3><p>@Model.StartDate.ToString("dd MMM yyyy") — @Model.EndDate.ToString("dd MMM yyyy")</p></div></div><div class="summary-list"><div><span>Transactions</span><b>@Model.Transactions.Count</b></div><div><span>Income entries</span><b>@Model.Transactions.Count(t => t.Type == PersonalFinanceManager.Models.TransactionType.Income)</b></div><div><span>Expense entries</span><b>@Model.Transactions.Count(t => t.Type == PersonalFinanceManager.Models.TransactionType.Expense)</b></div><div><span>Top spending category</span><b>@(Model.CategorySpending.FirstOrDefault()?.CategoryName ?? "—")</b></div></div></article></section>
<section class="panel report-transactions"><div class="panel-heading"><div><h3>Transactions in this period</h3><p>@Model.Transactions.Count entries found</p></div></div><div class="ledger-head"><span>Description</span><span>Account</span><span>Category</span><span>Amount</span><span></span></div>@foreach (var transaction in Model.Transactions) { <div class="ledger-row"><div><i class="@(transaction.Type == PersonalFinanceManager.Models.TransactionType.Income ? "income-icon" : "expense-icon")">@((transaction.Type == PersonalFinanceManager.Models.TransactionType.Income) ? "↓" : "↑")</i><p><strong>@(string.IsNullOrWhiteSpace(transaction.Note) ? transaction.Category?.Name : transaction.Note)</strong><small>@transaction.TransactionDate.ToString("dd MMM yyyy") · @transaction.Type</small></p></div><span>@transaction.Account?.Name</span><span class="category-pill">@transaction.Category?.Name</span><b class="@(transaction.Type == PersonalFinanceManager.Models.TransactionType.Income ? "income" : "expense")">@(transaction.Type == PersonalFinanceManager.Models.TransactionType.Income ? "+" : "−") Rs. @transaction.Amount.ToString("N0")</b><span></span></div> }@if (!Model.Transactions.Any()) { <div class="empty-mini">No transactions found for this period.</div> }</section>
