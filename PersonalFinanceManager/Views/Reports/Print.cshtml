@model PersonalFinanceManager.Models.ReportViewModel
@{Layout=null;}
<!doctype html><html><head><title>SpendWise Report</title><style>body{font-family:Arial;color:#172033;margin:35px}h1{color:#5853eb}.stats{display:flex;gap:12px}.card{flex:1;background:#f4f5fa;padding:14px;border-radius:8px}.card b{font-size:20px;display:block}table{width:100%;border-collapse:collapse;margin-top:22px}th,td{padding:9px;border-bottom:1px solid #ddd;text-align:left;font-size:12px}.income{color:#16825f}.expense{color:#d4505e}</style></head><body><button onclick="window.print()">Print / Save as PDF</button><h1>spendwise financial report</h1><p>@Model.StartDate.ToString("dd MMM yyyy") — @Model.EndDate.ToString("dd MMM yyyy")</p><div class="stats"><div class="card">Income<b class="income">Rs. @Model.TotalIncome.ToString("N0")</b></div><div class="card">Expenses<b class="expense">Rs. @Model.TotalExpense.ToString("N0")</b></div><div class="card">Net<b>Rs. @Model.NetCashFlow.ToString("N0")</b></div></div><table><tr><th>Date</th><th>Description</th><th>Account</th><th>Category</th><th>Amount</th></tr>@foreach(var t in Model.Transactions){<tr><td>@t.TransactionDate.ToString("dd MMM yyyy")</td><td>@(t.Note??t.Category?.Name)</td><td>@t.Account?.Name</td><td>@t.Category?.Name</td><td>@t.Amount.ToString("N0")</td></tr>}</table></body></html>
