@model PersonalFinanceManager.Models.UserPreference
@{ ViewData["Title"]="Settings"; }
<section class="dashboard-header"><div><p class="eyebrow">PERSONALIZE SPENDWISE</p><h1>Settings</h1><p class="subtle">Manage your profile, financial preferences and alerts.</p></div></section>
@if(TempData["Success"] is string message){<div class="alert alert-success border-0 shadow-sm">@message</div>}
<section class="settings-layout"><form asp-action="Index" method="post" enctype="multipart/form-data"><article class="settings-card"><div class="settings-title"><h3>Profile</h3><p>How SpendWise addresses you.</p></div><div class="form-group"><label asp-for="DisplayName"></label><input asp-for="DisplayName" class="form-control"/><span asp-validation-for="DisplayName" class="text-danger small"></span></div><div class="form-group"><label asp-for="ProfileImage"></label><input asp-for="ProfileImage" class="form-control" accept=".jpg,.jpeg,.png,.webp"/><span asp-validation-for="ProfileImage" class="text-danger small"></span></div><a class="edit-link" asp-action="ChangePassword">Change password</a></article><article class="settings-card"><div class="settings-title"><h3>Preferences</h3></div><div class="form-group"><label asp-for="Currency"></label><select asp-for="Currency" class="form-select"><option value="PKR">PKR — Pakistani Rupee</option><option value="USD">USD — US Dollar</option><option value="AED">AED — UAE Dirham</option></select></div><div class="form-group"><label asp-for="Theme"></label><select asp-for="Theme" class="form-select"><option>System</option><option>Light</option><option>Dark</option></select></div></article><article class="settings-card"><div class="settings-title"><h3>Notifications</h3></div><label class="toggle-row"><span><b>Budget alerts</b><small>Notify when a category reaches 80%.</small></span><input asp-for="BudgetAlerts" type="checkbox"/><i></i></label><label class="toggle-row"><span><b>Goal deadline alerts</b><small>Notify when a goal deadline is close.</small></span><input asp-for="GoalAlerts" type="checkbox"/><i></i></label></article><div class="form-actions"><button class="primary-button">Save settings</button></div></form></section>
