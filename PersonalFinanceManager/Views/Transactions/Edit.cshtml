@model PersonalFinanceManager.Models.FinanceTransaction
@{ ViewData["Title"] = "Edit transaction"; }
<section class="dashboard-header"><div><p class="eyebrow">FINANCIAL ENTRY</p><h1>Edit transaction</h1><p class="subtle">Correct the amount, date, account or category.</p></div><a class="back-link" asp-action="Index">← Back to transactions</a></section>
<section class="form-panel"><form asp-action="Edit" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="form-group"><label asp-for="Type"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<PersonalFinanceManager.Models.TransactionType>()" class="form-select"></select></div><div class="form-group"><label asp-for="AccountId"></label><select asp-for="AccountId" asp-items="ViewBag.Accounts" class="form-select"></select><span asp-validation-for="AccountId" class="text-danger small"></span></div><div class="form-group"><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select><span asp-validation-for="CategoryId" class="text-danger small"></span></div><div class="form-group"><label asp-for="Amount"></label><div class="amount-input"><span>Rs.</span><input asp-for="Amount" class="form-control" type="number" min="1" step="0.01" /></div><span asp-validation-for="Amount" class="text-danger small"></span></div><div class="form-group"><label asp-for="TransactionDate"></label><input asp-for="TransactionDate" class="form-control" /></div><div class="form-group"><label asp-for="Note"></label><input asp-for="Note" class="form-control" /><span asp-validation-for="Note" class="text-danger small"></span></div><div class="form-actions"><a asp-action="Index" class="cancel-button">Cancel</a><button type="submit" class="primary-button">Save changes</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
