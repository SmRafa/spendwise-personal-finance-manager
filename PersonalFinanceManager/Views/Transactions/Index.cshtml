@model PersonalFinanceManager.Models.TransactionListViewModel
@{ ViewData["Title"] = "Transactions"; }
<section class="dashboard-header"><div><p class="eyebrow">TRACK YOUR MONEY</p><h1>Transactions</h1><p class="subtle">Every income and expense in one place.</p></div><a class="primary-button text-decoration-none" asp-action="Create"><span>＋</span> Add transaction</a></section>
@if (TempData["Success"] is string message) { <div class="alert alert-success border-0 shadow-sm">@message</div> }
<section class="transaction-filters"><form method="get"><input name="search" value="@Model.Search" placeholder="Search note or category" /><select name="accountId" asp-items="ViewBag.Accounts"><option value="">All accounts</option></select><select name="categoryId" asp-items="ViewBag.Categories"><option value="">All categories</option></select><select name="type" asp-items="Html.GetEnumSelectList<PersonalFinanceManager.Models.TransactionType>()"><option value="">All types</option></select><input name="startDate" type="date" value="@Model.StartDate?.ToString("yyyy-MM-dd")" /><input name="endDate" type="date" value="@Model.EndDate?.ToString("yyyy-MM-dd")" /><button class="primary-button" type="submit">Filter</button><a asp-action="Index">Clear</a></form></section>
<section class="ledger-panel">
    <div class="ledger-head"><span>Description</span><span>Account</span><span>Category</span><span class="amount-heading">Amount</span><span class="actions-heading">Actions</span></div>
    @foreach (var transaction in Model.Items)
    {
        <article class="ledger-row">
            <div><i class="@(transaction.Type == PersonalFinanceManager.Models.TransactionType.Income ? "income-icon" : "expense-icon")">@((transaction.Type == PersonalFinanceManager.Models.TransactionType.Income) ? "↓" : "↑")</i><p><strong>@(string.IsNullOrWhiteSpace(transaction.Note) ? transaction.Category?.Name : transaction.Note)</strong><small>@transaction.TransactionDate.ToString("dd MMM yyyy") · @transaction.Type</small></p></div>
            <span>@transaction.Account?.Name</span><span class="category-pill">@transaction.Category?.Name</span>
            <b class="@(transaction.Type == PersonalFinanceManager.Models.TransactionType.Income ? "income" : "expense")">@(transaction.Type == PersonalFinanceManager.Models.TransactionType.Income ? "+" : "−") Rs. @transaction.Amount.ToString("N0")</b>
            <span class="ledger-actions"><a class="edit-link" asp-action="Edit" asp-route-id="@transaction.Id">Edit</a><form class="inline-form" asp-action="Delete" asp-route-id="@transaction.Id" method="post"><button onclick="return confirm('Delete this transaction?')" aria-label="Delete transaction">×</button></form></span>
        </article>
    }
    @if (!Model.Items.Any()) { <div class="empty-state"><div>⇄</div><h3>No transactions found</h3><p>Try changing filters or add your first income/expense.</p><a class="primary-button text-decoration-none" asp-action="Create">Add transaction</a></div> }
</section>
@if (Model.TotalPages > 1) { <nav class="pager"><span>Showing @Model.Items.Count of @Model.TotalCount</span><div>@for (var number = 1; number <= Model.TotalPages; number++) { <a class="@(number == Model.Page ? "active" : "")" asp-action="Index" asp-route-page="@number" asp-route-search="@Model.Search" asp-route-accountId="@Model.AccountId" asp-route-categoryId="@Model.CategoryId" asp-route-type="@Model.Type" asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">@number</a> }</div></nav> }
