@model PersonalFinanceManager.Models.AccountTransfer
@{ ViewData["Title"]="New transfer"; }
<section class="dashboard-header"><div><p class="eyebrow">MOVE MONEY</p><h1>New transfer</h1><p class="subtle">Transfer money between your accounts.</p></div><a class="back-link" asp-action="Index">← Back</a></section>
<section class="form-panel"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="form-group"><label asp-for="FromAccountId"></label><select asp-for="FromAccountId" asp-items="ViewBag.Accounts" class="form-select"><option value="">Select source</option></select></div><div class="form-group"><label asp-for="ToAccountId"></label><select asp-for="ToAccountId" asp-items="ViewBag.Accounts" class="form-select"><option value="">Select destination</option></select></div><div class="form-group"><label asp-for="Amount"></label><div class="amount-input"><span>Rs.</span><input asp-for="Amount" class="form-control" type="number" min="1" step="0.01"/></div></div><div class="form-group"><label asp-for="TransferDate"></label><input asp-for="TransferDate" class="form-control"/></div><div class="form-group"><label asp-for="Note"></label><input asp-for="Note" class="form-control" placeholder="Optional note"/></div><div class="form-actions"><a asp-action="Index" class="cancel-button">Cancel</a><button class="primary-button">Save transfer</button></div></form></section>
