@model IEnumerable<PersonalFinanceManager.Models.AccountTransfer>
@{ ViewData["Title"]="Transfers"; }
<section class="dashboard-header"><div><p class="eyebrow">MOVE MONEY BETWEEN ACCOUNTS</p><h1>Account transfers</h1><p class="subtle">Transfers do not affect your total balance.</p></div><a class="primary-button text-decoration-none" asp-action="Create"><span>＋</span> New transfer</a></section>
<section class="ledger-panel"><div class="ledger-head"><span>Transfer</span><span>Date</span><span>Note</span><span>Amount</span><span></span></div>@foreach(var item in Model){<article class="ledger-row"><div><i class="transfer-icon">⇄</i><p><strong>@item.FromAccount?.Name → @item.ToAccount?.Name</strong><small>Internal transfer</small></p></div><span>@item.TransferDate.ToString("dd MMM yyyy")</span><span>@(item.Note??"—")</span><b>Rs. @item.Amount.ToString("N0")</b><form asp-action="Delete" asp-route-id="@item.Id" method="post"><button onclick="return confirm('Delete this transfer?')">×</button></form></article>}@if(!Model.Any()){<div class="empty-state"><div>⇄</div><h3>No transfers yet</h3><p>Move money between accounts.</p><a class="primary-button text-decoration-none" asp-action="Create">New transfer</a></div>}</section>
